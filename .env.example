# Copy to .env and fill in. Never commit .env.

# REQUIRED by the SEC: identify yourself. Your name and a real email address.
# Requests without this get an "Undeclared Automated Tool" error.
SEC_USER_AGENT=Your Name your@email.com

# Optional: share prices for valuation ratios. Free key (25 requests/day):
# https://www.alphavantage.co/support/#api-key
# Without it, prices come from data/prices_manual.csv.
ALPHAVANTAGE_API_KEY=

# Labels only - conventions, not rules. See docs/methodology.md.
GROWTH_THRESHOLD=0.10
YIELD_THRESHOLD=0.03
